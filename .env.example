# Copy to .env on the server and fill in. .env is never committed (see .gitignore).

# Domain of the dashboard (A record -> this server). Caddy gets the HTTPS certificate for it.
DOMAIN=montaj.example.uz
# 1 behind HTTPS (normal). 0 only for a local test over plain http.
COOKIE_SECURE=1

# First admin, created on the first start only. Change the password later from the dashboard ("Parol").
DASH_ADMIN_USER=admin
DASH_ADMIN_PASSWORD=change-me-please

# Claude uses API billing through the existing Claude Code agent. No Claude /login is needed.
# Put the real key only in .env, never in source code or a Docker build argument.
ANTHROPIC_API_KEY=
# Optional API gateway (use BASE_URL + AUTH_TOKEN together instead of API_KEY):
# ANTHROPIC_BASE_URL=
# ANTHROPIC_AUTH_TOKEN=
# Higgsfield is separate: MCP is registered automatically; run OAuth login once (DEPLOY.md section 6).

# Container memory limit (whisper large-v3 + matting need ~6-8 GB at peak)
MEM_LIMIT=12g

# Videos (raw, refs, renders, AI assets) are deleted N days after the job's last run; the record stays. 0 = never.
DASH_RETENTION_DAYS=14
